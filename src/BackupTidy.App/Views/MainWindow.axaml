<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:BackupTidy.App.ViewModels"
        x:Class="BackupTidy.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="BackupTidy"
        Width="1240" Height="800" MinWidth="980" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource FondoApp}">

    <DockPanel>
        <Border DockPanel.Dock="Top" Padding="28,14" Background="{DynamicResource FondoTarjeta}"
                BorderBrush="{DynamicResource Borde}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="BackupTidy" FontSize="20" FontWeight="Bold" />
                    <TextBlock Text="Ordena los backups del celular sin borrar nada" Classes="secundario"
                               VerticalAlignment="Center" />
                </StackPanel>
                <ItemsControl Grid.Column="2" ItemsSource="{Binding Pasos}" VerticalAlignment="Center">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" Spacing="4" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:PasoVista">
                            <Border Classes="paso" Classes.actual="{Binding EsActual}" Classes.hecho="{Binding EsHecho}">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Text="{Binding Numero}" FontWeight="Bold" />
                                    <TextBlock Text="{Binding Nombre}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Border>

        <ContentControl Content="{Binding Pagina}" />
    </DockPanel>
</Window>
