<?xml version="1.0" encoding="utf-8"?>
<!--
  Un unico BackupTidy.exe que no necesita .NET instalado:
  dotnet publish src/BackupTidy.App -p:PublishProfile=win-x64
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- Skia, HarfBuzz y ANGLE adentro del .exe: se extraen solos al iniciar -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <CopyDebugSymbolFilesFromPackages>false</CopyDebugSymbolFilesFromPackages>
    <PublishDir>$(MSBuildThisFileDirectory)..\..\..\..\publish\win-x64\</PublishDir>
  </PropertyGroup>

  <!-- Los paquetes de Skia y los proyectos referenciados igual copian sus simbolos: no van en la entrega -->
  <Target Name="SinSimbolosDeDepuracion" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
